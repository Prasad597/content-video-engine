{
  "name": "content-video-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable audio-first content video engine for Shorts",
  "scripts": {
    "generate-audio": "tsx -- scripts/generate-audio.ts",
    "prepare-short": "tsx -- scripts/prepare-short.ts",
    "produce-short": "tsx -- scripts/produce-short.ts",
    "test:production": "tsx -- scripts/production.test.ts",
    "test:publishing": "tsx -- scripts/publishing.test.ts",
    "align-short": "tsx -- scripts/align-short.ts",
    "approve-timing": "tsx -- scripts/approve-timing.ts",
    "test:manual-timing": "tsx -- scripts/manual-timing.test.ts",
    "test:music": "tsx -- scripts/music.test.ts",
    "test:preview-timing": "tsx -- scripts/preview-timing.test.ts",
    "dev": "tsx -- scripts/studio.ts",
    "render": "tsx -- scripts/render-short.ts --content short-001 --channel noskip-learning",
    "render-short": "tsx -- scripts/render-short.ts",
    "new-short": "tsx -- scripts/new-short.ts",
    "typecheck": "tsc --noEmit",
    "validate": "tsx -- scripts/validate.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/studio": "4.0.532",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
