{
  "name": "content-video-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Experiment 001: one Java interview Short",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts JavaUncheckedExceptionV3 out/video_001_v3.mp4 --codec=h264 --crf=18",
    "render:interactive": "remotion render src/index.ts JavaUncheckedExceptionV3Interactive out/video_001_FINAL_INTERACTIVE.mp4 --codec=h264 --crf=18",
    "render:v2": "remotion render src/index.ts JavaUncheckedExceptionV2 out/video_001_v2.mp4 --codec=h264 --crf=18",
    "render:v1": "remotion render src/index.ts JavaUncheckedException out/video_001.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/studio": "4.0.532",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
